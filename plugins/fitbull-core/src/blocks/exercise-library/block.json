{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fitbull/exercise-library",
	"version": "1.0.0",
	"title": "Exercise library",
	"category": "widgets",
	"icon": "universal-access",
	"description": "Filterable grid of exercises by muscle, equipment and level, loaded from the Fitbull REST API.",
	"keywords": [ "workout", "exercise", "muscle", "filter" ],
	"textdomain": "fitbull-core",
	"attributes": {
		"perPage": { "type": "number", "default": 12 },
		"showFilters": { "type": "boolean", "default": true }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
