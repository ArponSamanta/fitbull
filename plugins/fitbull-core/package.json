{
	"name": "fitbull-core",
	"version": "1.0.1",
	"private": true,
	"description": "Content types, REST API and interactive blocks for the Fitbull fitness site.",
	"author": "Arpon Samanta",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "npm run build:blocks && npm run build:editor",
		"build:blocks": "wp-scripts build --webpack-src-dir=src/blocks --output-path=build/blocks",
		"build:editor": "wp-scripts build index=./index.js --webpack-src-dir=src/editor --output-path=build/editor",
		"start": "wp-scripts start --webpack-src-dir=src/blocks --output-path=build/blocks",
		"lint:js": "wp-scripts lint-js src",
		"lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
		"test": "wp-scripts test-unit-js",
		"format": "wp-scripts format src"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.0.0",
		"typescript": "^5.9.3"
	}
}
