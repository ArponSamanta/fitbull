{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fitbull/meal-planner",
	"version": "1.0.0",
	"title": "Meal planner",
	"category": "widgets",
	"icon": "food",
	"description": "A day of Indian meals that lands close to a calorie and protein target.",
	"keywords": [
		"meal",
		"plan",
		"diet",
		"calories"
	],
	"textdomain": "fitbull-core",
	"attributes": {},
	"supports": {
		"html": false,
		"align": [
			"wide"
		],
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"viewScript": "file:./view.js",
	"style": [
		"file:./style-index.css",
		"fitbull-core-ui"
	],
	"render": "file:./render.php"
}