{
	"name": "arponsamanta/arponsamanta-fitness-toolkit",
	"description": "Content types, REST API and interactive blocks for fitness sites.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"scripts": {
		"test": "phpunit",
		"lint": "find . -path ./vendor -prune -o -path ./node_modules -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l"
	},
	"config": {
		"sort-packages": true
	}
}
