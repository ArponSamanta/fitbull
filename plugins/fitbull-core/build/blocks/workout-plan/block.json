{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "fitbull/workout-plan",
  "version": "1.0.0",
  "title": "Workout plan generator",
  "category": "widgets",
  "icon": "calendar-alt",
  "description": "A weekly training plan built from your exercise library, based on goal, days, level and equipment.",
  "keywords": [
    "workout",
    "plan",
    "program",
    "routine"
  ],
  "textdomain": "fitbull-core",
  "attributes": {},
  "supports": {
    "html": false,
    "align": [
      "wide"
    ],
    "spacing": {
      "margin": true
    }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": [
    "file:./style-index.css",
    "fitbull-core-ui"
  ],
  "render": "file:./render.php"
}